{
  "name": "@panda/daemon",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @panda/shared build && pnpm --filter @panda/core build && pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.1",
    "@panda/core": "workspace:*",
    "@panda/shared": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
